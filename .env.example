# Credenciais do Supabase (Project Settings > API no painel do Supabase).
# Copie este arquivo para .env.local e preencha com os valores reais.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-public-key

# ── Funções serverless (/api) — variáveis de RUNTIME da Vercel ────────────────
# NÃO levam prefixo VITE_ (ficam só no servidor, nunca no bundle do front).
# Configure em Vercel > Project > Settings > Environment Variables.
# Para testar localmente com `vercel dev`, coloque-as também no .env.local.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
GEMINI_API_KEY=sua-chave-do-google-ai-studio
# Opcional: trocar o modelo (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
