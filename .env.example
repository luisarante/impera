# Credenciais do Supabase (Project Settings > API no painel do Supabase).
# Copie este arquivo para .env.local e preencha com os valores reais.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-public-key

# ── Funções serverless (/api) — variáveis de RUNTIME da Vercel ────────────────
# NÃO levam prefixo VITE_ (ficam só no servidor, nunca no bundle do front).
# Configure em Vercel > Project > Settings > Environment Variables.
# Para testar localmente com `vercel dev`, coloque-as também no .env.local.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
GEMINI_API_KEY=sua-chave-do-google-ai-studio
# Opcional: trocar o modelo (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# ── Sincronização com a EA Pro Clubs (scripts/ea-sync-local.mjs) ─────────────
# A EA bloqueia por IP as chamadas vindas de servidores de nuvem (Vercel,
# AWS, etc.), então essa sincronização roda LOCALMENTE (seu PC), não como
# Vercel Function. Preencha aqui e rode `npm run sync:ea` (ou agende no
# Agendador de Tarefas do Windows). Id do clube (proclubs.ea.com) e
# plataforma ('common-gen5' cobre PS5/Xbox Series/PC na maioria dos casos).
EA_CLUB_ID=1716582
EA_PLATFORM=common-gen5
